      "credentials": {
        "googlePalmApi": {
          "id": "b2bVDEYSTI4j0LvO",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nlet raw = '';\nif (j.content && Array.isArray(j.content.parts)) {\n  raw = j.content.parts.map(p => p.text || '').join('');\n} else if (typeof j.text === 'string') {\n  raw = j.text;\n} else if (typeof j.content === 'string') {\n  raw = j.content;\n} else {\n  raw = JSON.stringify(j);\n}\nraw = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\nconst start = raw.indexOf('{');\nconst end = raw.lastIndexOf('}');\nlet data = {};\ntry {\n  data = JSON.parse(raw.slice(start, end + 1));\n} catch (e) {\n  throw new Error('Gemini did not return valid JSON: ' + raw.slice(0, 300));\n}\nlet total = data.total_amount;\nif (typeof total === 'string') {\n  const n = parseFloat(total.replace(/[^0-9.\\-]/g, ''));\n  total = isNaN(n) ? total : n;\n}\nreturn {\n  json: {\n    'Supplier Name': data.supplier_name ?? '',\n    'Invoice Number': data.invoice_number ?? '',\n    'Invoice Date': data.invoice_date ?? '',\n    'Total Amount': total ?? '',\n    'Currency': data.currency ?? '',\n    'Processed At': $now.toISO(),\n  },\n};"
      },
